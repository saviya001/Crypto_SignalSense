# Groq API Key (Used for fast classification: Llama 3.1 8B)
GROQ_API_KEY=your_groq_api_key_here

# OpenRouter API Key (Used for deep synthesis & reflection: DeepSeek / Claude / GPT-4)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: Custom OpenRouter Model selection (Defaults to deepseek/deepseek-chat or anthropic/claude-3.5-sonnet)
OPENROUTER_MODEL=deepseek/deepseek-chat
